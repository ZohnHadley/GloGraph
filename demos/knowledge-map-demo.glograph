          "isEnabled": true,
          "showOnCard": true
        }
      ]
    },
    {
      "id": "c5000000-0000-0000-0000-000000000002",
      "title": "Call to Adventure",
      "description": "A disruption that forces the hero out of their comfort zone. A message, a stranger, a crisis. The story actually starts here. Refusal is common — and temporary.",
      "eventDate": null,
      "dateAdded": "2026-05-25T00:00:00Z",
      "x": 512.0,
