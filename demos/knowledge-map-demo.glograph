    {
      "id": "c5000000-0000-0000-0000-000000000005",
      "title": "The Supreme Ordeal",
      "description": "The central crisis — the hero faces death (literal or symbolic) and must draw on everything learned so far. The darkest moment before the transformation.",
      "eventDate": null,
      "dateAdded": "2026-05-25T00:00:00Z",
