  "nodes": [
    {
      "id": "c5000000-0000-0000-0000-000000000001",
      "title": "Ordinary World",
      "description": "The hero's starting point — familiar, comfortable, limited. We meet Luke on Tatooine, Frodo in the Shire, Dorothy in Kansas. The status quo before the adventure begins.",
      "eventDate": null,
      "dateAdded": "2026-05-25T00:00:00Z",
      "x": 128.0,
      "y": 448.0,
      "color": null,
      "confidence": null,
