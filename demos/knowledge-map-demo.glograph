    },
    {
      "id": "c5000000-0000-0000-0000-000000000003",
      "title": "Crossing the Threshold",
      "description": "The point of no return. The hero commits to the journey by entering the special world. Ordinary rules no longer apply. This is where Act 1 ends.",
      "eventDate": null,
      "dateAdded": "2026-05-25T00:00:00Z",
