    {
      "id": "c5000000-0000-0000-0000-000000000004",
      "title": "Road of Trials",
      "description": "A gauntlet of tests, enemies, and allies. The hero fails often. Each trial is a lesson in disguise. This is where the protagonist is forged.",
      "eventDate": null,
      "dateAdded": "2026-05-25T00:00:00Z",
