# Cloudflare Pages headers — security + caching.
# Cloudflare Pages reads this file from the deploy root. Note: the deploy script
# (scripts/deploy-site.mjs) skips most "_"-prefixed files but allow-lists this one.

# Security headers on every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), browsing-topics=()

# Long-lived immutable caching for static assets.
# Images live under /assets and the OG card is filename-versioned (og-image-vN.png),
# so a changed asset gets a new URL rather than serving stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Demo bundle is content-hashed by Vite (index-<hash>.js, etc.).
/demo/assets/*
  Cache-Control: public, max-age=31536000, immutable

# styles.css / main.js have no content hash, but the deploy appends a per-deploy
# ?v=<token> to their references in the HTML, so each version is a distinct URL.
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/main.js
  Cache-Control: public, max-age=31536000, immutable
